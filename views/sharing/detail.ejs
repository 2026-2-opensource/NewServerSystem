<style>
.back-link { color:#2d5a27; text-decoration:none; font-size:14px; display:inline-flex; align-items:center; gap:6px; margin-bottom:20px; }
.detail-card { background:#fff; border-radius:20px; padding:32px; box-shadow:0 2px 12px rgba(0,0,0,.08); margin-bottom:20px; }
.detail-header { display:flex; gap:24px; align-items:flex-start; margin-bottom:24px; }
.detail-img { width:100px; height:100px; background:#f0f8ec; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:52px; flex-shrink:0; }
.detail-title { font-size:22px; font-weight:700; color:#1a3a15; margin-bottom:10px; }
.detail-meta { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
.meta-tag { background:#f5f5f5; padding:6px 14px; border-radius:20px; font-size:13px; color:#666; }
.detail-content { background:#f8fdf4; border-radius:12px; padding:16px; font-size:14px; color:#555; line-height:1.6; margin-bottom:20px; white-space: pre-wrap; }
.detail-actions { display:flex; gap:10px; justify-content:flex-end; align-items:center; margin-top:20px; }
.btn-back { background:#fff; color:#555; border:1.5px solid #e0e0e0; padding:12px 24px; border-radius:10px; font-size:14px; cursor:pointer; text-decoration:none; display:inline-block; font-weight:600; }
.status-done { background:#f5f5f5; color:#999; padding:12px 24px; border-radius:10px; font-size:14px; font-weight:600; display:inline-block; }
</style>

<%
// 카테고리 매핑 함수
function getCategoryEmoji(cat) {
  if(!cat) return '🍽️';
  const map={'채소':'🥬','과일':'🍎','육류':'🥩','수산물':'🐟','유제품':'🥛','달걀':'🥚','가공식품':'🍱','조미료':'🧂','냉동식품':'🧊'};
  return map[cat]||'🍽️';
}

// 현재 식재료 카테고리 판별
let itemCategory = '';
if(post.ownedIngredient) {
    itemCategory = post.ownedIngredient.ingredient ? post.ownedIngredient.ingredient.categoryInfo : post.ownedIngredient.categoryInfo;
}
%>

<div class="detail-card">
  <div class="detail-header">
    <div class="detail-img"><%= getCategoryEmoji(itemCategory) %></div>
    <div>
      <div class="detail-title">
        <%= post.postTitle %>
      </div>
      <div class="detail-meta">
        <span class="meta-tag">👤 <%= post.member ? post.member.memberName : '알 수 없는 사용자' %></span>
        <span class="meta-tag">📍 <%= post.dong %></span>
        
        <%
          let qtyStr = String(post.registeredQuantity || '1개');
          let numMatch = qtyStr.match(/^[\d.]+/);
          let unitStr = qtyStr.replace(/^[\d.]+/, '').trim();
        %>
        <span class="meta-tag">📦 나눔 수량: <%= numMatch ? parseFloat(numMatch[0]) : 1 %><%= unitStr %></span>
        <span class="meta-tag">🏷️ 식재료: <%= post.ownedIngredient ? post.ownedIngredient.ingredientName : '알 수 없음' %></span>
        
        <% if (currentUser !== post.memberId) { %>
          <a href="/sharing?memberId=<%= post.memberId %>" class="meta-tag" style="background:#e8f5e0; color:#2d5a27; font-weight:600; text-decoration:none;">📝 작성글 보기</a>
          <button type="button" onclick="reportAndBlockFromDetail()" class="meta-tag" style="background:#ffebee; color:#c62828; border:none; font-weight:600; cursor:pointer;">⚠️ 신고/차단</button>
        <% } %>
      </div>
    </div>
  </div>

  <div class="detail-content"><%= post.postContent %></div>

  <div class="detail-actions">
    <% if (!post.sharingStatus && currentUser === post.memberId) { %>
      <span style="font-size:13px; color:#888; margin-right:auto;">
        💡 아래 채팅 목록에서 나눔을 완료해주세요.
      </span>
    <% } else if (post.sharingStatus) { %>
      <span class="status-done" style="margin-right:auto;">✅ 나눔이 완료된 게시글입니다.</span>
    <% } %>

    <% if (currentUser === post.memberId) { %>
      <button type="button" class="btn-back" style="color:#2d5a27; border-color:#c8e6c9;" onclick="openEditPostModal()">수정</button>
      <button type="button" class="btn-back" style="color:#c62828; border-color:#ffcdd2; margin:0;" onclick="openDeleteModal()">삭제</button>
    <% } %>
    <a href="/sharing" class="btn-back">목록으로</a>
  </div>
</div>

<div class="modal-overlay" id="deletePostModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:24px; padding:36px 32px; width:320px; text-align:center; box-shadow:0 8px 40px rgba(0,0,0,0.2);">
    <div style="font-size:17px;font-weight:800;color:#222;margin-bottom:8px;">정말로 삭제하시겠습니까?</div>
    <div style="font-size:13px;color:#888;margin-bottom:28px;line-height:1.6;">게시글이 삭제되며, 연결된 식재료는<br>다시 내 냉장고로 안전하게 돌아갑니다.</div>
    <div style="display:flex;gap:10px;">
      <button type="button" onclick="closeDeleteModal()" style="flex:1;background:#f5f5f5;color:#555;border:none;border-radius:12px;padding:13px;font-size:14px;font-weight:700;cursor:pointer;">취소</button>
      
      <form action="/sharing/<%= post.sharingId %>/delete" method="POST" style="flex:1; margin:0;">
        <button type="submit" style="width:100%;background:#e74c3c;color:#fff;border:none;border-radius:12px;padding:13px;font-size:14px;font-weight:700;cursor:pointer;">삭제</button>
      </form>
    </div>
  </div>
</div>



<div class="chat-action-section" style="background:#fff; border-radius:20px; padding:32px; box-shadow:0 2px 12px rgba(0,0,0,.08);">
  <% if (currentUser !== post.memberId) { %>
    <div style="text-align:center;">
        <% if (!post.sharingStatus) { %>
            <p style="color:#666; font-size:14px; margin-bottom:16px;">관심 있으신가요? 작성자에게 메시지를 보내보세요!</p>
            <form action="/chat/start" method="POST" style="margin:0;">
              <input type="hidden" name="sharingId" value="<%= post.sharingId %>">
              <input type="hidden" name="sellerId" value="<%= post.memberId %>">
              <button type="submit" style="background:#2d5a27; color:#fff; border:none; padding:16px 32px; border-radius:12px; font-size:16px; font-weight:700; cursor:pointer; width:100%; max-width:300px; box-shadow:0 4px 12px rgba(45,90,39,0.2);">
                💬 작성자와 채팅하기
              </button>
            </form>
        <% } else { %>
            <p style="color:#888; font-size:15px; font-weight:600; padding:20px; background:#f5f5f5; border-radius:12px;">이 나눔은 이미 완료되어 새 채팅을 보낼 수 없습니다. 📭</p>
        <% } %>
    </div>
  <% } else { %>
    <p style="color:#2d5a27; font-size:16px; font-weight:700; margin:0 0 16px 0; border-bottom:1px solid #e8f5e0; padding-bottom:10px;">
      💬 진행 중인 대화 목록
    </p>
    
    <% if (locals.chatRooms && chatRooms.length > 0) { %>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <% chatRooms.forEach(room => { %>
          <div style="display:flex; justify-content:space-between; align-items:center; background:#f8fdf4; padding:16px 20px; border-radius:12px; border:1px solid #e8f5e0;">
            <div style="display:flex; flex-direction:column; gap:6px;">
                <span style="font-weight:600; font-size:15px; color:#1a3a15;">👤 <%= room.buyer ? room.buyer.memberName : '알 수 없는 사용자' %>님</span>
                <a href="/chat/room/<%= room.roomId %>" style="font-size:13px; color:#2d5a27; font-weight:600; text-decoration:underline;">대화방 입장하기 ➔</a>
            </div>
            
            <% if (!post.sharingStatus) { %>
              <form action="/sharing/<%= post.sharingId %>/complete" method="POST" style="margin:0;">
                <input type="hidden" name="receiverId" value="<%= room.buyerId %>">
                <button type="submit" onclick="return confirm('<%= room.buyer ? room.buyer.memberName : '상대방' %>님에게 나눔을 완료하시겠습니까? (보유 식재료가 차감됩니다)')" style="background:#2d5a27; color:#fff; border:none; padding:10px 16px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 4px rgba(45,90,39,0.2);">
                  🎉 나눔 완료하기
                </button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center; padding:30px 0; color:#888; font-size:14px;">
        아직 도착한 채팅이 없습니다.<br>도움이 필요한 이웃의 연락을 기다려보세요!
      </div>
    <% } %>
  <% } %>
</div>


<div class="modal-overlay" id="editPostModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:1000; align-items:center; justify-content:center;">
  <div class="modal" style="background:#fff; border-radius:20px; padding:32px; width:500px;">
    <div class="modal-header" style="display:flex; justify-content:between; align-items:center; margin-bottom:20px;">
      <div class="modal-title" style="font-weight:700; font-size:18px;">✏️ 게시글 수정</div>
    </div>
    <form action="/sharing/<%= post.sharingId %>/edit" method="POST">
      <div class="form-group" style="margin-bottom:14px;">
        <label class="modal-label" style="display:block; font-size:12px; color:#666; margin-bottom:6px;">제목</label>
        <input type="text" name="postTitle" id="editPostTitle" class="modal-input" style="width:100%; padding:11px; border:1.5px solid #e0e0e0; border-radius:10px;" value="<%= post.postTitle %>" required>
      </div>
      <div class="form-group" style="margin-bottom:14px;">
        <label class="modal-label" style="display:block; font-size:12px; color:#666; margin-bottom:6px;">수량</label>
        <input type="text" name="registeredQuantity" class="modal-input" style="width:100%; padding:11px; border:1.5px solid #e0e0e0; border-radius:10px;" value="<%= post.registeredQuantity %>" required>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label class="modal-label" style="display:block; font-size:12px; color:#666; margin-bottom:6px;">설명</label>
        <textarea name="postContent" id="editPostContent" class="modal-input" rows="5" style="width:100%; padding:11px; border:1.5px solid #e0e0e0; border-radius:10px; resize:none;" required><%= post.postContent %></textarea>
      </div>
      <div class="modal-btns" style="display:flex; gap:10px; justify-content:flex-end;">
        <button type="button" class="modal-btn-cancel" onclick="closeEditPostModal()" style="background:#fff; border:1px solid #ddd; padding:10px 20px; border-radius:10px; cursor:pointer; font-weight:600; color:#555;">취소</button>
        <button type="submit" class="modal-btn-submit" style="background:#2d5a27; color:#fff; border:none; padding:10px 20px; border-radius:10px; cursor:pointer; font-weight:600;">수정 완료</button>
      </div>
    </form>
  </div>
</div>

<script>
function openDeleteModal() {
    document.getElementById('deletePostModal').style.display = 'flex';
}
function closeDeleteModal() {
    document.getElementById('deletePostModal').style.display = 'none';
}

// 게시글 수정 모달 제어
function openEditPostModal() {
    document.getElementById('editPostModal').style.display = 'flex';
}
function closeEditPostModal() {
    document.getElementById('editPostModal').style.display = 'none';
}

// 신고 및 차단 로직
async function reportAndBlockFromDetail() {
    if (!confirm('이 사용자를 신고하고 즉시 차단하시겠습니까?\n차단 시 메인으로 이동하며, 이 사용자의 모든 글이 숨김 처리됩니다.')) return;
    
    try {
        const res = await fetch('/sharing/report-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ blockedId: '<%= post.memberId %>', roomId: null })
        });
        const data = await res.json();
        
        if (data.success) {
            alert(data.message);
            location.href = '/sharing'; // 메인으로 강제 탈출
        } else {
            alert(data.message || '처리 중 오류가 발생했습니다.');
        }
    } catch(e) {
        alert('신고 처리 중 서버 에러가 발생했습니다.');
    }
}
</script>