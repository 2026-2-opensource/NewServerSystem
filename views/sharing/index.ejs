<style>
.page-title-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.page-title { font-size:22px; font-weight:700; color:#1a3a15; }
.district-badge { background:#e8f5e0; color:#2d5a27; padding:6px 14px; border-radius:20px; font-size:13px; font-weight:700; display:inline-block; }
.btn-primary { background:#2d5a27; color:#fff; padding:10px 20px; border-radius:10px; font-size:14px; font-weight:600; border:none; cursor:pointer; }
.filter-tabs { display:flex; gap:8px; margin-bottom:20px; align-items:center; }
.filter-tab { padding:7px 16px; border-radius:20px; font-size:13px; font-weight:500; text-decoration:none; color:#888; background:#fff; border:1.5px solid #e0e0e0; }
.filter-tab.active { background:#2d5a27; color:#fff; border-color:#2d5a27; }
.sharing-list { display:flex; flex-direction:column; gap:12px; }
.sharing-card { background:#fff; border-radius:16px; padding:18px 20px; display:grid; grid-template-columns:70px 1fr auto; gap:16px; align-items:center; box-shadow:0 2px 8px rgba(0,0,0,.06); text-decoration:none; color:inherit; transition:box-shadow .15s; }
.sharing-card:hover { box-shadow:0 4px 20px rgba(0,0,0,.1); }
.sharing-img { width:70px; height:70px; background:#f0f8ec; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:36px; }
.sharing-title { font-size:15px; font-weight:700; color:#222; margin-bottom:6px; }
.sharing-meta { display:flex; flex-wrap:wrap; gap:10px; font-size:12px; color:#999; margin-bottom:4px; }
.sharing-content { font-size:13px; color:#888; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:400px; }
.status-badge { display:inline-block; padding:5px 14px; border-radius:20px; font-size:12px; font-weight:700; white-space:nowrap; }
.badge-sharing { background:#e8f5e0; color:#2d5a27; }
.badge-done { background:#f5f5f5; color:#999; }
.badge-reserved { background:#fff3e0; color:#ef6c00; }
.empty-state { text-align:center; padding:80px; color:#bbb; }
.empty-icon { font-size:56px; margin-bottom:16px; }

.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:1000; align-items:center; justify-content:center; }
.modal-overlay.open { display:flex; }
.modal { background:#fff; border-radius:20px; padding:32px; width:500px; box-shadow:0 12px 48px rgba(0,0,0,.15); max-height: 90vh; overflow-y: auto; }
.modal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
.modal-title { font-size:18px; font-weight:700; color:#1a3a15; }
.modal-close { background:none; border:none; font-size:20px; cursor:pointer; color:#aaa; }
.form-group { margin-bottom:14px; }
.modal-label { display:block; font-size:12px; color:#666; margin-bottom:6px; font-weight:600; }
.modal-input { width:100%; padding:11px 14px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:14px; box-sizing:border-box; font-family:inherit; background:#fafafa; }
.modal-input:focus { outline:none; border-color:#2d5a27; background:#fff; }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.modal-btns { display:flex; gap:10px; justify-content:flex-end; margin-top:20px; }
.modal-btn-cancel { background:#fff; color:#888; border:1.5px solid #e0e0e0; padding:11px 20px; border-radius:10px; cursor:pointer; font-size:14px; }
.modal-btn-submit { background:#2d5a27; color:#fff; border:none; padding:11px 24px; border-radius:10px; cursor:pointer; font-size:14px; font-weight:600; }

.ingredient-scroll-box { border: 1.5px solid #e0e0e0; border-radius: 10px; background: #fafafa; max-height: 280px; overflow-y: auto; margin-bottom: 14px; }
.ingredient-select-item { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #f5f5f5; cursor: pointer; transition: background 0.15s;}
.ingredient-select-item:hover { background: #f0f8ec; }
.ingredient-select-item.selected { background: #e8f5e0; border-left: 4px solid #2d5a27; }
.ing-left { display: flex; align-items: center; gap: 12px; }
.ing-name { font-size: 14px; font-weight: 600; color: #222; }
.ing-loc { font-size: 11px; color: #999; margin-top: 2px; }
.dday-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.badge-expired { background: #ffebee; color: #c62828; }
.badge-urgent { background: #fff3e0; color: #ef6c00; }
.badge-safe { background: #e8f5e0; color: #2d5a27; }
</style>

<%
function getCategoryEmoji(cat) {
  const map={'채소':'🥬','과일':'🍎','육류':'🥩','수산물':'🐟','유제품':'🥛','달걀':'🥚','가공식품':'🍱','조미료':'🧂','냉동식품':'🧊'};
  return map[cat]||'🍽️';
}

function formatDateToYYYYMMDD(dateString) {
  if (!dateString) return '';
  const d = new Date(dateString);
  return `${d.getFullYear()}년 ${String(d.getMonth() + 1).padStart(2, '0')}월 ${String(d.getDate()).padStart(2, '0')}일`;
}
%>

<div class="page-title-row">
  <div>
    <h2 class="page-title">나눔 게시판</h2>
    <div style="margin-top:6px;">
      <span class="district-badge">📍 <%= typeof locationText !== 'undefined' ? locationText : dong %> 전체 게시판</span>
    </div>
  </div>
  <button class="btn-primary" onclick="checkAgreement()">+ 나눔 등록</button>
</div>

<div class="filter-tabs">
  <div style="display:flex; gap:8px; flex:1;">
      <a href="/sharing?filter=all<%= typeof myPost !== 'undefined' && myPost === 'true' ? '&myPost=true' : '' %>" class="filter-tab <%= (!locals.filter || filter==='all')?'active':'' %>">전체</a>
      <a href="/sharing?filter=sharing<%= typeof myPost !== 'undefined' && myPost === 'true' ? '&myPost=true' : '' %>" class="filter-tab <%= locals.filter==='sharing'?'active':'' %>">나눔 중</a>
      <a href="/sharing?filter=reserved<%= typeof myPost !== 'undefined' && myPost === 'true' ? '&myPost=true' : '' %>" class="filter-tab <%= locals.filter==='reserved'?'active':'' %>">예약 중</a>
      <a href="/sharing?filter=done<%= typeof myPost !== 'undefined' && myPost === 'true' ? '&myPost=true' : '' %>" class="filter-tab <%= locals.filter==='done'?'active':'' %>">나눔 완료</a>
  </div>
  <select id="postFilterSelect" style="padding:6px 10px; border-radius:8px; border:1px solid #ddd; font-size:13px; color:#555; background:#f5f5f5; outline:none; cursor:pointer; margin-left:8px;">
    <option value="all" <%= (typeof myPost === 'undefined' && typeof excludeMyPost === 'undefined') ? 'selected' : '' %>>모든 게시글 보기</option>
    <option value="mine" <%= (typeof myPost !== 'undefined' && myPost === 'true') ? 'selected' : '' %>>내 게시글만 보기</option>
    <option value="exclude" <%= (typeof excludeMyPost !== 'undefined' && excludeMyPost === 'true') ? 'selected' : '' %>>내 게시글 제외하기</option>
</select>
</div>

<% if (typeof posts !== 'undefined' && posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🌱</div>
    <p style="font-size:15px;font-weight:600;color:#ccc;">해당하는 나눔 게시물이 없어요</p>
  </div>
<% } %>

<div class="sharing-list">
  <% if (typeof posts !== 'undefined') { %>
    <% posts.forEach(post => { 
        let cat = '';
        if(post.ownedIngredient) {
            cat = post.ownedIngredient.ingredient ? post.ownedIngredient.ingredient.categoryInfo : post.ownedIngredient.categoryInfo;
        }
    %>
      <a href="/sharing/<%= post.sharingId %>" class="sharing-card">
        <div class="sharing-img"><%= getCategoryEmoji(cat) %></div>
        <div>
          <% 
            let isReserved = post.postTitle && post.postTitle.startsWith('[예약중]'); 
            let displayTitle = post.postTitle || (post.postContent ? post.postContent.substring(0,30) : '제목 없음');
            if (isReserved) displayTitle = displayTitle.replace('[예약중] ', '');
          %>
          <div class="sharing-title"><%= displayTitle %></div>
          <div class="sharing-meta">
            <span>👤 <%= post.member ? post.member.memberName : '알 수 없는 사용자' %></span>
            <span>📍 <%= post.dong %></span>
            <% if(post.ownedIngredient && post.ownedIngredient.expiryDate) { %>
              <span style="color:#e67e22; font-weight:600;">
                ⏳ 유통기한: <%= formatDateToYYYYMMDD(post.ownedIngredient.expiryDate) %>
              </span>
            <% } %>
            <% 
              let qtyStr = String(post.registeredQuantity || '1개');
              let numMatch = qtyStr.match(/^[\d.]+/);
              let unitStr = qtyStr.replace(/^[\d.]+/, '').trim();
            %>
            <span>📦 수량 <%= numMatch ? parseFloat(numMatch[0]) : 1 %><%= unitStr %></span>
            <% if(post.ownedIngredient) { %>
              <span>🏷️ <%= post.ownedIngredient.ingredient ? post.ownedIngredient.ingredient.ingredientName : (post.ownedIngredient.ingredientName || '식재료') %></span>
            <% } %>
          </div>
          <div class="sharing-content"><%= post.postContent %></div>
        </div>
        <div>
          <% 
             let statusTxt = '나눔중'; let badgeCls = 'badge-sharing';
             if (post.sharingStatus) { statusTxt = '나눔 완료'; badgeCls = 'badge-done'; }
             else if (isReserved) { statusTxt = '예약중'; badgeCls = 'badge-reserved'; }
          %>
          <span class="status-badge <%= badgeCls %>"><%= statusTxt %></span>
        </div>
      </a>
    <% }) %>
  <% } %>
</div>

<div class="modal-overlay" id="shareModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">🤝 나눔 등록</div>
      <button class="modal-close" onclick="closeShareModal()">✕</button>
    </div>
    <form action="/sharing/create" method="POST" id="createShareForm">
      <div class="form-group">
        <label class="modal-label">제목 *</label>
        <input type="text" name="postTitle" class="modal-input" placeholder="예: 우유 2팩 나눔해요!" required>
      </div>
      
      <div class="form-group">
        <label class="modal-label" style="display:flex; align-items:center; gap:6px;">
          식재료 선택(내 냉장고에 있는 식재료를 선택하세요)
          <button type="button" onclick="document.getElementById('agreementModal').classList.add('open')"
          style="background:#f5f5f5; border:1px solid #ddd; border-radius:12px; padding:4px 10px; font-size:11px; cursor:pointer; color:#555; white-space:nowrap;">
          ❓나눔 금지 품목
        </button>
        </label>
        <div class="ingredient-scroll-box" id="modalScrollBox">
          <% if (typeof myIngredients !== 'undefined' && myIngredients.length > 0) { %>
            <% myIngredients.forEach(ing => { %>
              <div class="ingredient-select-item" onclick="selectIngredient(this, '<%= ing.ownedIngredientId %>', '<%= ing.quantity %>')">
                <div class="ing-left">
                  <div>
                    <div class="ing-name"><%= ing.displayName || '식재료' %></div>
                    <div class="ing-loc">보유: <%= ing.quantity %> / 유통기한: <%= formatDateToYYYYMMDD(ing.expiryDate) %></div>
                  </div>
                </div>
                <div><span class="dday-badge <%= ing.ddayClass %>"><%= ing.ddayText %></span></div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; color:#bbb; font-size:13px; padding:32px 0;">내 냉장고에 나눔 가능한 식재료가 없습니다.</div>
          <% } %>
        </div>
      </div>

      <div class="form-group">
        <label class="modal-label">설명 *</label>
        <textarea name="postContent" class="modal-input" rows="3" placeholder="나눔할 식재료에 대해 설명해주세요" style="resize:none;" required></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="modal-label">나눔 수량 * (숫자만 입력)</label>
          <div style="display:flex; gap:8px;">
            <input type="number" id="inputNum" step="any" class="modal-input" placeholder="숫자 입력" style="flex:1;" required>
            <select id="unitDropdown" class="modal-input" style="width:90px; display:none;"></select>
            <span id="staticUnit" style="padding:10px 14px; background:#eee; border-radius:10px; display:none; font-size:14px; font-weight:600; color:#555;">개</span>
          </div>
        </div>
        <div class="form-group">
          <label class="modal-label">공유 지역</label>
          <input type="text" class="modal-input" value="<%= dong %>" readonly style="background:#f5f5f5; color:#666; cursor:not-allowed;">
        </div>
      </div>
      <input type="hidden" name="registeredQuantity" id="registeredQuantity">
      <input type="hidden" name="ownedIngredientId" id="modalOwnedIngredientId" value="" required>
      <div class="modal-btns">
        <button type="button" class="modal-btn-cancel" onclick="closeShareModal()">취소</button>
        <button type="submit" class="modal-btn-submit">등록하기</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="agreementModal" style="z-index:9999 !important;">
  <div class="modal" style="width:500px;">
    <div class="modal-header">
      <div class="modal-title">⚠️ 나눔 전 필수 확인 수칙</div>
      <button type="button" class="modal-close" onclick="document.getElementById('agreementModal').classList.remove('open'); return false;">✕</button>
    </div>
    <div class="modal-body" style="font-size:13px; color:#555; line-height:1.6; max-height:400px; overflow-y:auto; padding:20px;">
      <b>다음 항목은 나눔이 엄격히 금지되며, 문제 발생 시 법적 책임은 나눔 제공자에게 있습니다.</b><br><br>
      • <b>유통기한 경과 및 변질 식품:</b> 기한이 지났거나 상한 식품<br>
      • <b>보관 상태 불명확 조리식품:</b> 온도/시간 관리가 안 된 음식<br>
      • <b>냉장/냉동 필수 식품:</b> 안전성이 훼손될 우려가 있는 식품<br>
      • <b>알레르기 미표기 제품:</b> 성분 확인이 불가능한 제품<br>
      • <b>주류, 의약품, 마약류 등 법령상 거래 금지 품목</b><br>
      • <b>살아있는 동물 및 사체, 상업적 재판매 목적 물품</b>
    </div>
    <div class="modal-footer" style="padding: 16px 28px 24px;">
      <button class="modal-btn-submit" style="width:100%; py:12px;" onclick="submitAgreement()">위 수칙을 확인하였으며, 동의합니다</button>
    </div>
  </div>
</div>


<script>
let originalAmount = 0;
let baseUnit = '';

document.getElementById('postFilterSelect')?.addEventListener('change', function() {
    const url = new URL(window.location.href);
    url.searchParams.delete('myPost');
    url.searchParams.delete('excludeMyPost');
    
    if (this.value === 'mine') url.searchParams.set('myPost', 'true');
    else if (this.value === 'exclude') url.searchParams.set('excludeMyPost', 'true');
    
    window.location.href = url.toString();
});

function checkAgreement() {
  const isAgreed = <%= (user && user.sharingAgreement) ? 'true' : 'false' %>;
    if (isAgreed===true) {
        openShareModal(); 
    } else {
        document.getElementById('agreementModal').classList.add('open');
    }
}
async function submitAgreement() {
    try {
        const res = await fetch('/sharing/agree-terms', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            document.getElementById('agreementModal').classList.remove('open');
            alert('동의가 완료되었습니다. 나눔글 작성을 진행합니다.');
            location.reload(); // 동의 시점을 반영하기 위해 새로고침 후 모달 오픈 유도
        }
    } catch(e) { 
        alert('오류가 발생했습니다.'); 
    }
}
function openShareModal() { document.getElementById('shareModal').classList.add('open'); }
function closeShareModal() { 
  document.getElementById('shareModal').classList.remove('open'); 
  document.getElementById('createShareForm').reset();
  document.querySelectorAll('.ingredient-select-item').forEach(el => el.classList.remove('selected'));
  document.getElementById('modalOwnedIngredientId').value = '';
  document.getElementById('unitDropdown').style.display = 'none';
  document.getElementById('staticUnit').style.display = 'none';
}

function selectIngredient(element, id, rawQty) {
  document.querySelectorAll('.ingredient-select-item').forEach(el => el.classList.remove('selected'));
  element.classList.add('selected');
  document.getElementById('modalOwnedIngredientId').value = id;
  
  const qStr = String(rawQty || '1').trim();
  const numMatch = qStr.match(/^[\d.]+/);
  const strMatch = qStr.replace(/^[\d.]+/, '').replace(/\s/g, '').toLowerCase();

  originalAmount = numMatch ? parseFloat(numMatch[0]) : 1;
  baseUnit = strMatch || '개';

  const dropEl = document.getElementById('unitDropdown');
  const staticEl = document.getElementById('staticUnit');

  if (['l', 'ml', '리터'].includes(baseUnit)) {
     dropEl.innerHTML = '<option value="ml">ml</option><option value="L">L</option>';
     dropEl.style.display = 'block'; staticEl.style.display = 'none';
     baseUnit = 'ml';
     if (strMatch === 'l' || strMatch === 'L') originalAmount *= 1000; 
  } else if (['g', 'kg'].includes(baseUnit)) {
     dropEl.innerHTML = '<option value="g">g</option><option value="kg">kg</option>';
     dropEl.style.display = 'block'; staticEl.style.display = 'none';
     baseUnit = 'g';
     if (strMatch === 'kg') originalAmount *= 1000;
  } else {
     dropEl.style.display = 'none'; staticEl.style.display = 'block';
     staticEl.innerText = baseUnit;
  }
}

document.addEventListener('DOMContentLoaded', () => {
    // URL에 파라미터가 있으면 화면이 켜질 때 자동으로 체크
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('excludeMyPost') === 'true') {
        document.getElementById('excludeMyPostFilter').checked = true;
    }

    // 체크박스를 누르면 URL을 변경하고 새로고침
    document.getElementById('excludeMyPostFilter')?.addEventListener('change', function() {
        const url = new URL(window.location.href);
        if (this.checked) url.searchParams.set('excludeMyPost', 'true');
        else url.searchParams.delete('excludeMyPost');
        window.location.href = url.toString();
    });
});

document.getElementById('createShareForm').addEventListener('submit', function(e) {
  const modalIngId = document.getElementById('modalOwnedIngredientId').value;
  if (!modalIngId) { e.preventDefault(); alert('식재료를 선택해주세요.'); return; }
  
  let inputVal = parseFloat(document.getElementById('inputNum').value);
  let finalUnit = '';

  const dropEl = document.getElementById('unitDropdown');
  if (dropEl.style.display !== 'none') {
      const selectedUnit = dropEl.value;
      let compareVal = inputVal;
      if (selectedUnit === 'L' || selectedUnit === 'kg') compareVal *= 1000;

      if (compareVal > originalAmount) {
         e.preventDefault(); alert('입력 수량이 현재 보유량을 초과합니다!'); return;
      }
      finalUnit = selectedUnit;
  } else {
      if (inputVal > originalAmount) {
         e.preventDefault(); alert('입력 수량이 보유 수량을 초과합니다!'); return;
      }
      finalUnit = baseUnit;
  }

  document.getElementById('registeredQuantity').value = inputVal + finalUnit;
});

document.getElementById('shareModal').addEventListener('click', function(e){ 
  if(e.target === document.getElementById('shareModal')) closeShareModal(); 
});

document.getElementById('excludeMyPostFilter')?.addEventListener('change', function() {
    const url = new URL(window.location.href);
    if (this.checked) url.searchParams.set('excludeMyPost', 'true');
    else url.searchParams.delete('excludeMyPost');
    window.location.href = url.toString();
});

</script>