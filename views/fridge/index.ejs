async function handleReceiptUpload(input) {
  if (!input.files || input.files.length === 0) return;
  
  const file = input.files[0];
  const formData = new FormData();
  formData.append('receipt', file); 

  document.getElementById('ocrLoading').classList.add('show');

  try {
    const response = await fetch('/fridge/ocr', { 
      method: 'POST',
      body: formData
    });
    const data = await response.json();

    document.getElementById('ocrLoading').classList.remove('show');

    if (data.success && data.parsedIngredients && data.parsedIngredients.length > 0) {
      openOcrResultModal(data.parsedIngredients);
    } else {
      throw new Error(data.message || '인식된 식재료 정보가 없거나 실패했습니다.');
    }
  } catch (error) {
    document.getElementById('ocrLoading').classList.remove('show');
    alert('영수증 분석 중 오류가 발생했습니다: ' + error.message);
  } finally {
    input.value = ''; 
  }
}

function openOcrResultModal(ingredients) {
  const listContainer = document.getElementById('ocrIngredientsList');
  listContainer.innerHTML = '';

  ingredients.forEach((item, index) => {
    const row = document.createElement('div');
    row.className = 'ocr-item-row';
    row.style.display = 'flex';
    row.style.gap = '6px'; 
    row.style.alignItems = 'center';
    row.id = `ocr-row-${index}`;

    const categories = ['채소', '과일', '육류', '수산물', '유제품', '달걀', '가공식품', '조미료', '냉동식품', '기타'];
    const categoryOptions = categories.map(cat => 
      `<option value="${cat}" ${item.categoryInfo === cat ? 'selected' : ''}>${cat}</option>`
    ).join('');

    row.innerHTML = `
      <input type="text" class="modal-input ocr-name-input" value="${item.ingredientName}" placeholder="식재료명" style="flex: 1.5; margin: 0; min-width: 0; padding: 11px 10px;">
      
      <input type="text" class="modal-input ocr-quantity-input" value="${item.quantity || '1개'}" placeholder="수량" 
             style="flex: 0.6; margin: 0; min-width: 0; text-align: center; padding: 11px 4px; box-sizing: border-box;">

      <select class="modal-input ocr-category-select" style="flex: 1.0; margin: 0; height: 41px; min-width: 0; padding: 0 4px 0 8px;">
        ${categoryOptions}
      </select>

      <select class="modal-input ocr-storage-select" style="flex: 1.0; margin: 0; height: 41px; min-width: 0; padding: 0 4px 0 8px;">
        <option value="냉장실" ${item.storageMethod === '냉장실' ? 'selected' : ''}>냉장실</option>
        <option value="냉동실" ${item.storageMethod === '냉동실' ? 'selected' : ''}>냉동실</option>
        <option value="실온" ${item.storageMethod === '실온' ? 'selected' : ''}>실온</option>
      </select>

      <input type="number" class="modal-input ocr-price-input" value="${item.price || 0}" placeholder="가격" min="0" style="flex: 1.0; margin: 0; min-width: 0; padding: 11px 8px; text-align: right;">

      <input type="date" class="modal-input ocr-date-input" value="${item.expiryDate}" style="flex: 1.4; margin: 0; min-width: 0; padding: 11px 6px;">
      
      <input type="hidden" class="ocr-id-input" value="${item.ingredientId || ''}">

      <button type="button" onclick="document.getElementById('ocr-row-${index}').remove()" 
              style="background:#fff; color:#aaa; border:1.5px solid #eee; padding:10px; border-radius:10px; cursor:pointer; height: 41px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">✕</button>
    `;
    listContainer.appendChild(row);
  });

  document.getElementById('ocrResultModal').classList.add('open');
}

async function submitOcrIngredients() {
  const nameInputs = document.querySelectorAll('.ocr-name-input');
  const quantityInputs = document.querySelectorAll('.ocr-quantity-input'); 
  const categorySelects = document.querySelectorAll('.ocr-category-select');
  const storageSelects = document.querySelectorAll('.ocr-storage-select');
  const priceInputs = document.querySelectorAll('.ocr-price-input');
  const dateInputs = document.querySelectorAll('.ocr-date-input');
  const idInputs = document.querySelectorAll('.ocr-id-input');
  
  const ingredients = [];
  
  for (let i = 0; i < nameInputs.length; i++) {
    const ingredientName = nameInputs[i].value.trim();
    const quantity = quantityInputs[i].value.trim() || '1개'; 
    const categoryInfo = categorySelects[i].value;
    const storageMethod = storageSelects[i].value;
    const price = priceInputs[i] ? parseInt(priceInputs[i].value) || 0 : 0;
    const expiryDate = dateInputs[i].value;
    const ingredientId = idInputs[i].value ? parseInt(idInputs[i].value) : null;

    if (ingredientName) {
      ingredients.push({ 
        ingredientName, 
        quantity,
        categoryInfo,
        storageMethod, 
        price,
        expiryDate,
        ingredientId
      });
    }
  }

  if (ingredients.length === 0) {
    alert('등록할 식재료가 없습니다.');
    return;
  }

  try {
    const response = await fetch('/fridge/ocr/confirm', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ingredients })
    });
    const data = await response.json();

    if (data.success) {
      alert(data.message);
      location.reload(); 
    } else {
      alert('등록 실패: ' + data.message);
    }
  } catch (error) {
    console.error(error);
    alert('최종 등록 처리 중 서버 에러가 발생했습니다.');
  }
}

