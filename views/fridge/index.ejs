
<style>
.page-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;}
.page-title{font-size:22px;font-weight:700;color:#1a3a15;}
.btn-primary{background:#2d5a27;color:#fff;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:600;border:none;cursor:pointer;}
.filter-tabs{display:flex;gap:6px;margin-bottom:20px;}
.filter-tab{padding:8px 16px;border-radius:20px;font-size:13px;font-weight:500;text-decoration:none;color:#888;background:#fff;border:1.5px solid #e0e0e0;}
.filter-tab.active{background:#2d5a27;color:#fff;border-color:#2d5a27;}
.fridge-table{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.06);}

.fridge-table{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.06);}
.table-header{display:grid;grid-template-columns:36px 44px 1fr 110px 70px 90px 80px 180px;padding:12px 20px;background:#f8fdf4;border-bottom:1px solid #eee;}
.table-header span{font-size:12px;font-weight:600;color:#888;}
.table-row{display:grid;grid-template-columns:36px 44px 1fr 110px 70px 90px 80px 180px;padding:12px 20px;border-bottom:1px solid #f5f5f5;align-items:center;}

/* 🔥 나눔중(sharing-mode)일 때는 가격 열(80px)을 지운 7열 레이아웃으로 작동하게 만듭니다 */
.sharing-mode .table-header,
.sharing-mode .table-row {
  grid-template-columns: 36px 44px 1fr 110px 70px 90px 180px;
}
.table-row:hover{background:#fafffe;}
.item-icon{font-size:22px;}
.item-name{font-size:14px;font-weight:600;color:#222;}
.item-sub{font-size:11px;color:#aaa;margin-top:2px;}
.expiry-badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;}
.badge-expired{background:#ffe8e8;color:#c0392b;}
.badge-today{background:#fff3e0;color:#ed7308;}
.badge-urgent{background:#fff8e1;color:#f39c12;}
.badge-soon{background:#e8f5e0;color:#27ae60;}
.badge-safe{background:#e8f5fe;color:#2980b9;}
.storage-tag{font-size:11px;color:#888;background:#f5f5f5;padding:3px 8px;border-radius:6px;}
.table-actions{ display:grid;
  grid-template-columns: repeat(2, 70px);
  gap:6px;
  justify-content:center;
   align-items:center;
}
.table-actions form{
  margin:0;
  padding:0;
}
.btn-consume{background:#27ae60;color:#fff;border:none;padding:5px 10px;border-radius:8px;font-size:11px;cursor:pointer;font-weight:600;}
.btn-discard{background:#fff;color:#e74c3c;border:1.5px solid #eee;padding:5px 8px;border-radius:8px;font-size:11px;cursor:pointer;}
.btn-share{background:#2d5a27;color:#fff;border:none;padding:5px 8px;border-radius:8px;font-size:11px;cursor:pointer;}
.btn-edit{
  background:#f3f4f6;
  color:#333;
  border:none;
  padding:5px 10px;
  border-radius:8px;
  font-size:11px;
  cursor:pointer;
  font-weight:600;
}
.table-actions{
  display:grid;
  grid-template-columns: repeat(2, 70px);
  gap:6px;
  justify-content:center;
}

/* 모든 버튼 공통 크기 */
.btn-consume,
.btn-share,
.btn-discard,
.btn-edit{
  width:70px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:0;
  font-size:12px;
  font-weight:600;

  border-radius:10px;
  box-sizing:border-box;
}

.btn-delete{background:#fff;color:#aaa;border:1.5px solid #eee;padding:5px 8px;border-radius:8px;font-size:11px;cursor:pointer;}
.empty-table{text-align:center;padding:60px;color:#bbb;font-size:14px;}
.btn-bulk-delete{
  background:#e74c3c;
  color:#fff;
  border:none;
  padding:10px 16px;
  border-radius:10px;
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  pointer-events:auto;
  opacity:1;
}

.btn-bulk-delete:hover{
  opacity:0.9;
}
.btn-delete-expired{
  background:#c0392b;   /* 더 진한 레드 */
  color:#fff;
  border:none;
  padding:10px 16px;
  border-radius:10px;
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  transition: all 0.2s ease;
}

.btn-delete-expired:hover{
  background:#922b21;   /* hover 더 어둡게 */
  transform: translateY(-1px);
}
.page-title-row{
  position:relative;
  z-index:10;
}
.item-checkbox{
  width:16px;
  height:16px;
  cursor:pointer;
}

#checkAll{
  width:16px;
  height:16px;
  cursor:pointer;
}

/* 모달 */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:#fff;border-radius:20px;width:520px;max-height:90vh;display:flex;flex-direction:column;box-shadow:0 12px 48px rgba(0,0,0,.15);}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:24px 28px 16px;}
.modal-title{font-size:18px;font-weight:700;color:#1a3a15;}
.modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:#aaa;}
.modal-body{overflow-y:auto;padding:0 28px 20px;}
.modal-footer{padding:16px 28px 24px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid #f0f0f0;}
.modal-btn-cancel{background:#fff;color:#888;border:1.5px solid #e0e0e0;padding:11px 20px;border-radius:10px;cursor:pointer;font-size:14px;font-family:inherit;}
.modal-btn-submit{background:#2d5a27;color:#fff;border:none;padding:11px 24px;border-radius:10px;cursor:pointer;font-size:14px;font-weight:600;font-family:inherit;}

/* 입력 폼 */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-group.full{grid-column:span 2;}
.modal-label{display:block;font-size:12px;color:#666;margin-bottom:6px;font-weight:600;}
.modal-input{width:100%;padding:11px 14px;border:1.5px solid #e0e0e0;border-radius:10px;font-size:14px;box-sizing:border-box;font-family:inherit;background:#fafafa;}
.modal-input:focus{outline:none;border-color:#2d5a27;background:#fff;}
.auto-filled{border-color:#27ae60 !important;background:#f0fff4 !important;}

/* 자동입력 결과 카드 */
.analyze-result{background:#f8fdf4;border:1.5px solid #c8e6b8;border-radius:12px;padding:14px;margin-bottom:16px;display:none;}
.analyze-result.show{display:block;}
.result-row{display:flex;align-items:center;gap:8px;font-size:13px;color:#444;margin-bottom:6px;}
.result-row:last-child{margin-bottom:0;}
.result-icon{font-size:16px;width:20px;}
.result-label{color:#888;font-size:12px;width:60px;}
.result-value{font-weight:600;color:#2d5a27;}
.tip-text{font-size:11px;color:#888;margin-top:8px;padding-top:8px;border-top:1px solid #ddd;}

/* 방식 선택 모달 스타일 */
.choice-modal { width: 380px !important; }
.choice-body { display: flex; flex-direction: column; gap: 12px; padding: 10px 28px 28px !important; }
.btn-choice-option {
  display: flex; align-items: center; width: 100%; padding: 16px;
  background: #fafafa; border: 1.5px solid #e0e0e0; border-radius: 14px;
  cursor: pointer; transition: all 0.2s ease; text-align: left; font-family: inherit;
}
.btn-choice-option:hover { background: #f0fff4; border-color: #2d5a27; transform: translateY(-2px); }
.choice-icon { font-size: 26px; margin-right: 16px; display: flex; align-items: center; justify-content: center; }
.choice-text { display: flex; flex-direction: column; }
.choice-title { font-size: 15px; font-weight: 700; color: #222; margin-bottom: 2px; }
.choice-desc { font-size: 11px; color: #888; line-height: 1.4; }

/* 영수증 처리중 스피너 오버레이 */
.loading-overlay {
  display: none; position: fixed; inset: 0; background: rgba(255,255,255,0.85); 
  z-index: 2000; flex-direction: column; align-items: center; justify-content: center; gap: 15px;
}
.loading-overlay.show { display: flex; }
.ocr-spinner {
  width: 40px; height: 40px; border: 4px solid rgba(45,90,39,0.2); border-top-color: #2d5a27;
  border-radius: 50%; animation: ocr-spin 1s linear infinite;
}

/* 자동입력 결과 카드 통합형 스타일 */
.analyze-result {
  background: #f8fdf4;
  border: 1.5px solid #c8e6b8;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  display: none;
}
.analyze-result.show { display: block; }
.result-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}
.result-row:last-child { margin-bottom: 0; }
.result-icon { font-size: 16px; width: 20px; text-align: center; }
.result-label { color: #555; font-size: 12px; width: 65px; font-weight: 600; }

/* 카드 내부 전용 미니 인풋/셀렉트 박스  */
.inline-modify-input {
  flex: 1;
  padding: 6px 10px;
  border: 1px solid #c8e6b8;
  border-radius: 8px;
  font-size: 13px;
  font-family: inherit;
  background: #fff;
  color: #2d5a27;
  font-weight: 600;
  box-sizing: border-box;
}
.inline-modify-input:focus {
  outline: none;
  border-color: #2d5a27;
  box-shadow: 0 0 4px rgba(45,90,39,0.15);
}
@keyframes ocr-spin { to { transform: rotate(360deg); } }
</style>

<div id="jsFlash" style="display:none;background:#f0fff4;color:#27ae60;border:1px solid #b2dfdb;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:500;margin-bottom:16px;"></div>

<div class="page-title-row">
  <h2 class="page-title">내 냉장고</h2>

  <div style="display:flex; gap:10px;">
    <button
      type="button"
      class="btn-primary btn-delete-expired"
      id="deleteExpiredBtn"
    >
    만료된 식재료 삭제
    </button>

    <button 
      type="button"
      class="btn-delete btn-bulk-delete"
      id="deleteSelectedBtn"
    >
      선택 삭제
    </button>

    <button class="btn-primary" onclick="openChoiceModal()">
      + 식재료 추가
    </button>
  </div>
</div>

<div class="filter-tabs">
  <a href="/fridge?filter=all" class="filter-tab <%= filter==='all'?'active':'' %>">전체 (<%= counts.all %>)</a>
  <a href="/fridge?filter=today" class="filter-tab <%= filter==='today'?'active':'' %>">오늘까지 (<%= counts.today %>)</a>
  <a href="/fridge?filter=3days" class="filter-tab <%= filter==='3days'?'active':'' %>">3일 이내 (<%= counts.days3 %>)</a>
  <a href="/fridge?filter=week" class="filter-tab <%= filter==='week'?'active':'' %>">일주일 이내 (<%= counts.week %>)</a>
  <a href="/fridge?filter=safe" class="filter-tab <%= filter==='safe'?'active':'' %>">안전 (<%= counts.safe %>)</a>
  
  <a href="/fridge?filter=sharing" class="filter-tab <%= filter==='sharing'?'active':'' %>">나눔중 (<%= counts.sharing %>)</a>
</div>

<div class="fridge-table <%= filter === 'sharing' ? 'sharing-mode' : '' %>">
  <div class="table-header">
    <span>
      <input type="checkbox" id="checkAll">
    </span>
    <span></span><span>식재료</span><span>권장소비기한</span><span>상태</span><span>보관위치</span>
    
    <% if (filter !== 'sharing') { %>
      <span>가격</span>
    <% } %>
    
    <span>관리</span>
  </div>
  
  <% if(items.length===0){ %>
    <div class="empty-table">🥬 등록된 식재료가 없어요!</div>
  <% } %>

  <% items.forEach(item=>{ %>
    <% if ((filter === 'today' || filter === '3days') && item.status === 'expired') {
        return; 
      } 
    %>
    
    <div class="table-row">
       <div>
        <input
          type="checkbox"
          class="item-checkbox"
          value="<%= item.ownedIngredientId %>"
        >
      </div>
      <input type="number" id="consumeInput" style="display:none;">

      <div class="item-icon"><%= getCategoryEmoji(item.categoryInfo) %></div>
      
      <div>
        <div class="item-name"><%= item.ingredientName||'알 수 없음' %></div>
        <div class="item-sub">
          <% if (item.quantity) { %>
            <%= String(item.quantity).replace(/NaN/g, '') %>
          <% } %>
        </div>
      </div>
      
      <div style="font-size:13px;color:#555;"><%= new Date(item.expiryDate).toLocaleDateString('ko-KR') %></div>
      <div>
        <% if (item.status === 'today') { %>
          <span class="expiry-badge badge-today">D-Day</span>
        <% } else if (item.status === 'expired') { %>
          <span class="expiry-badge badge-expired">만료</span>
        <% } else { %>
          <span class="expiry-badge badge-<%= item.status %>">D-<%= item.daysLeft %></span>
        <% } %>
      </div>
      <div><span class="storage-tag"><%= item.storageMethod||'냉장실' %></span></div>
      
      <% if (filter !== 'sharing') { %>
        <div style="font-size:12px;color:#555;"><% if(item.amount){ %><%= parseInt(item.amount).toLocaleString() %>원<% } else { %>-<% } %></div>
      <% } %>
      
     <div class="table-actions">

  <button
    type="button"
    class="btn-consume"
    data-id="<%= item.ownedIngredientId %>"
    data-quantity="<%= item.quantity %>">
    ✅ 소비
  </button>

  <% if(!item.isSharing){ %>
    <button
      type="button"
      class="btn-share"
      onclick="location.href='/sharing?autoSelect=<%= item.ownedIngredientId %>'">
      나눔
    </button>
  <% } else { %>
    <span style="font-size:11px;color:#2d5a27;font-weight:600;">나눔중</span>
  <% } %>

  <form
    action="/fridge/<%= item.ownedIngredientId %>/delete"
    method="POST"
    style="margin:0"
    onsubmit="return deleteConfirm(event,this)">
    <button type="submit" class="btn-discard">🗑 폐기</button>
  </form>

  <button
    type="button"
    class="btn-edit"
    onclick="openEditModal(
      '<%= item.ownedIngredientId %>',
      '<%= item.ingredientName %>',
      '<%= item.quantity %>',
      '<%= new Date(item.expiryDate).toISOString().slice(0, 10) %>',
      '<%= item.storageMethod %>',
      '<%= item.categoryInfo %>',
      '<%= item.amount %>'
    )">
    수정
  </button>

</div>
    </div>
  <% }) %>
</div>

<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">✏️ 식재료 수정</div>
      <button class="modal-close" onclick="closeEditModal()">✕</button>
    </div>

    <div class="modal-body">
      <form id="editForm">
        <input type="hidden" id="editId">

        <div class="form-grid">
          <div class="form-group full">
            <label class="modal-label">식재료명</label>
            <input type="text" id="editName" class="modal-input">
          </div>

          <div class="form-group full">
            <label class="modal-label">수량</label>
            <input type="text" id="editQuantity" class="modal-input">
          </div>

          <div class="form-group full">
            <label class="modal-label">유통기한</label>
            <input type="date" id="editExpiry" class="modal-input">
          </div>

          <div class="form-group full">
            <label class="modal-label">보관방법</label>
            <select id="editStorage" class="modal-input">
              <option value="냉장실">냉장실</option>
              <option value="냉동실">냉동실</option>
              <option value="실온">실온</option>
            </select>
          </div>

          <div class="form-group full">
            <label class="modal-label">카테고리</label>
            <select id="editCategory" class="modal-input">
              <option value="채소">🥬 채소</option>
              <option value="과일">🍎 과일</option>
              <option value="육류">🥩 육류</option>
              <option value="해산물">🐟 해산물</option>
              <option value="유제품">🥛 유제품</option>
              <option value="냉동식품">🧊 냉동식품</option>
              <option value="기타">🍽️ 기타</option>
            </select>
          </div>

          <div class="form-group full">
            <label class="modal-label">금액</label>
            <input type="number" id="editAmount" class="modal-input">
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="modal-btn-cancel" onclick="closeEditModal()">취소</button>
          <button type="button" class="modal-btn-submit" onclick="submitEdit()">저장</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal-overlay" id="addChoiceModal">
  <div class="modal choice-modal">
    <div class="modal-header">
      <div class="modal-title">🍏 식재료 추가 방식</div>
      <button class="modal-close" onclick="closeChoiceModal()">✕</button>
    </div>
    <div class="modal-body choice-body">
      <button type="button" class="btn-choice-option" onclick="selectDirectInput()">
        <div class="choice-icon">✍️</div>
        <div class="choice-text">
          <span class="choice-title">직접 입력하기</span>
          <span class="choice-desc">식재료 명과 유통기한을 내가 직접 타이핑합니다.</span>
        </div>
      </button>
      <button type="button" class="btn-choice-option" onclick="selectReceiptInput()">
        <div class="choice-icon">🧾</div>
        <div class="choice-text">
          <span class="choice-title">영수증 첨부하기</span>
          <span class="choice-desc">마트 영수증 사진을 올려 여러 재료를 자동 분석합니다.</span>
        </div>
      </button>
    </div>
  </div>
</div>

<input type="file" id="receiptFileInput" accept="image/*" style="display:none;" onchange="handleReceiptUpload(this)">

<div class="loading-overlay" id="ocrLoading">
  <div class="ocr-spinner"></div>
  <div style="font-weight:600;color:#2d5a27;font-size:14px;">영수증 글자를 읽어 분석하고 있어요...</div>
</div>

<div class="modal-overlay" id="addModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">🥕 식재료 추가</div>
      <button class="modal-close" onclick="closeAddModal()">✕</button>
    </div>
    <div class="modal-body">
      <form action="/fridge/add" method="POST" id="addForm">
        <input type="hidden" name="fridgeId" value="<%= fridges[0]?fridges[0].fridgeId:'' %>">
        <input type="hidden" name="isEstimatedPrice" id="isEstimatedPrice" value="false">

        <div class="form-grid">
          <div class="form-group full">
            <label class="modal-label">식재료 이름 *</label>
            <input type="text" name="ingredientName" id="ingredientName" class="modal-input" placeholder="예: 우유, 닭가슴살, 브로콜리" required>
          </div>
          <div class="form-group full">
            <label class="modal-label">수량 / 무게</label>
            <input type="text" name="quantity" id="quantity" class="modal-input" placeholder="예: 1개, 500g, 1L, 2팩">
          </div>
        </div>

        <div class="analyze-result" id="analyzeResult">
          <div class="result-row">
            <span class="result-icon">📂</span>
            <span class="result-label" style="color: #555; font-size: 12px; width: 65px; font-weight: 600;">카테고리</span>
            <select name="categoryInfo" id="categoryInfo" class="modal-input" style="flex: 1; padding: 6px 10px; border: 1px solid #c8e6b8; border-radius: 8px; font-size: 13px; background: #fff; color: #2d5a27; font-weight: 600; height: auto; margin: 0;">
              <option value="채소">채소</option>
              <option value="과일">과일</option>
              <option value="육류">육류</option>
              <option value="수산물">수산물</option>
              <option value="유제품">유제품</option>
              <option value="달걀">달걀</option>
              <option value="가공식품">가공식품</option>
              <option value="조미료">조미료</option>
              <option value="냉동식품">냉동식품</option>
              <option value="기타" selected>기타</option>
            </select>
          </div>

          <div class="result-row">
            <span class="result-icon">📅</span>
            <span class="result-label" style="color: #555; font-size: 11px; width: 65px; font-weight: 600;">권장소비기한</span>
            <input type="date" name="expiryDate" id="expiryDate" class="modal-input" style="flex: 1; padding: 6px 10px; border: 1px solid #c8e6b8; border-radius: 8px; font-size: 13px; background: #fff; color: #2d5a27; font-weight: 600; height: auto; margin: 0;" required>
          </div>
          
          <div class="result-row">
