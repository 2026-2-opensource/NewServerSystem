function subtractQuantity(original, used){

  const number = parseFloat(original);
  const unit = original.replace(/[0-9.\s]/g, '');

  const remain = number - used;

  if(remain <= 0){
    return null;
  }

  return `${remain}${unit}`;
}

async function consumeIngredient(btn){
  
  const id = btn.dataset.id;
  const quantity = btn.dataset.quantity;

const used = await showConsumePrompt(quantity);

  if(used === null) return;

  const usedAmount = parseFloat(used);

  if(isNaN(usedAmount) || usedAmount <= 0){
    alert('올바른 숫자를 입력해주세요.');
    return;
  }

  try {

    const response = await fetch(`/fridge/${id}/consume`, {
      method:'POST',
      headers:{
        'Content-Type':'application/json'
      },
      body: JSON.stringify({
        usedAmount
      })
    });

    const data = await response.json();

    if(data.success){

      if(data.message) sessionStorage.setItem('flashMsg', data.message);

      location.reload();

    } else {

      alert(data.message || '실패');
    }

  } catch(err){

    console.error(err);

    alert('서버 오류');
  }
}

