<script>
const flashMsg = sessionStorage.getItem('flashMsg');
if (flashMsg) {
  const el = document.getElementById('jsFlash');
  el.textContent = flashMsg;
  el.style.display = 'block';
  sessionStorage.removeItem('flashMsg');
  setTimeout(() => el.style.display = 'none', 3000);
}

function showConfirm(title, message){

  return new Promise(resolve => {

    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;

    const modal = document.getElementById('confirmModal');

    modal.classList.add('open');

    document.getElementById('confirmOk').onclick = () => {
      modal.classList.remove('open');
      resolve(true);
    };

    document.getElementById('confirmCancel').onclick = () => {
      modal.classList.remove('open');
      resolve(false);
    };
  });
}
function showConsumePrompt(quantity){

  return new Promise(resolve => {

    const modal = document.getElementById('consumeModal');

    document.getElementById('consumeMessage').textContent =
      `현재 수량 : ${quantity}`;

    const input =
      document.getElementById('consumeAmountInput');

    input.value = '';

    modal.classList.add('open');

    document.getElementById('consumeOk').onclick = () => {

      modal.classList.remove('open');

      resolve(input.value);
    };

    document.getElementById('consumeCancel').onclick = () => {

      modal.classList.remove('open');

      resolve(null);
    };
  });
}

let analyzeTimer = null;

async function analyzeFood() {
  const name = document.getElementById('ingredientName').value.trim();
  const quantity = document.getElementById('quantity').value.trim();
  if (!name) return;

  try {
    const res = await fetch('/api/food/analyze', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, quantity }),
    });
    const data = await res.json();
    if (!data.success) return;

    document.getElementById('categoryInfo').value = data.category || '기타';
    document.getElementById('expiryDate').value = data.expiryDate;
    document.getElementById('storageMethod').value = data.storageMethod || '냉장실';
    
    document.getElementById('r-tip').textContent = `💡 ${data.tip}`;
    document.getElementById('analyzeResult').classList.add('show');

  } catch(e) {
    console.error(e);
  }
}

document.getElementById('ingredientName').addEventListener('input', function() {
  clearTimeout(analyzeTimer);

  const val = this.value.trim();
  if (val.length < 1) return;

  analyzeTimer = setTimeout(() => analyzeFood(), 600);
});

document.getElementById('quantity').addEventListener('blur', function() {
  const name = document.getElementById('ingredientName').value.trim();
  if (name) analyzeFood();
});

