<div class="page-header">
  <div class="page-header-top">
    <div class="page-header-user">
      <div class="user-avatar"><img src="/images/character/front.png" style="width:36px;height:36px;object-fit:contain;"></div>
      <div>
        <div class="welcome-text">안녕하세요, <strong><%= user.memberName %></strong> 주민님! 🌿</div>
        <div class="welcome-sub">오늘도 포레시와 함께 똑똑한 소비를 시작해요!</div>
      </div>
    </div>
    
  </div>
</div>

<div class="dashboard-grid">
  <div class="card card-wide">
    <div class="card-header">
      <h3 class="card-title">오늘 임박한 식재료</h3>
      <a href="/fridge" class="card-link">전체 보기 ›</a>
    </div>
    <div class="urgent-items">

      <% if (urgentIngredients.length === 0) { %>
        <div class="empty-state-small">🎉 임박한 식재료가 없어요!</div>
      <% } %>

      <% 
        // 카테고리 이모지 함수 선언
        const getCategoryEmoji = (cat) => {
          const map = {'채소':'🥬','과일':'🍎','육류':'🥩','수산물':'🐟','유제품':'🥛','달걀':'🥚','가공식품':'🍱','조미료':'🧂','냉동식품':'🧊'};
          return map[cat] || '🍽️';
        };
      %>

      <% urgentIngredients.forEach(item => { %>
        <div class="urgent-item">
          <div class="urgent-item-top">
            <div class="urgent-item-left">
              <div class="urgent-item-icon"><%= getCategoryEmoji(item.categoryInfo) %></div>
              <div class="urgent-item-name"><%= item.ingredientName || '알 수 없음' %></div>
            </div>
            <div class="urgent-item-day <%= item.daysLeft === 0 ? 'day0' : '' %>">
              <%= item.daysLeft === 0 ? 'D-DAY' : 'D-' + item.daysLeft %>
            </div>
          </div>
          <% if (item.amount) { %>
            <div class="urgent-item-save">소비하면 <%= parseInt(item.amount).toLocaleString() %>원 절약!</div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- 이번 달 활동 요약 -->
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">이번 달 활동 요약</h3>
      <span style="font-size:12px;color:#888;">통계기록은 임박 식재료 (D-3)에 한해서만 적용됩니다.</span>
    </div>
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-label">절약한 금액</div>
        <div class="stat-value"><%= (member.cumulativeSavings || 0).toLocaleString() %>원</div>
        <% if (savingsDiff >= 0) { %>
          <div style="font-size:11px;color:#2d5a27;margin-top:4px;">지난달보다 <%= savingsDiff.toLocaleString() %>원 더 아꼈어요!</div>
        <% } else { %>
          <div style="font-size:11px;color:#888;margin-top:4px;">지난달엔 <%= lastSavings.toLocaleString() %>원을 아꼈어요</div>
        <% } %>
      </div>
      <div class="stat-item">
        <div class="stat-label">CO₂ 절약</div>
        <div class="stat-value"><%= member.cumulativeCarbonReduction || 0 %>kg</div>
        <% if (treeDiff >= 0) { %>
          <div style="font-size:11px;color:#2d5a27;margin-top:4px;">소나무 <%= thisTreeCount %>그루를 심은 양과 같아요!</div>
        <% } else { %>
          <div style="font-size:11px;color:#888;margin-top:4px;">지난달엔 소나무 <%= lastTreeCount %>그루를 지켰어요!</div>
        <% } %>
      </div>
      <div class="stat-item" style="grid-column:span 2;">
        <div class="stat-label">나눔 완료</div>
        <div class="stat-value"><%= sharingCompleted %>회</div>
      </div>
    </div>
  </div>
</div>

<!-- 빠른 접근 버튼 -->
<div class="quick-actions">
  <a href="/fridge" class="quick-action-btn" onmouseover="document.getElementById('fridgeImg').src='/images/board/fridge.png'" onmouseout="document.getElementById('fridgeImg').src='/images/board/fridge2.png'">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
      <div>
        <span class="qa-label">냉장고 관리</span>
        <span class="qa-desc">식재료 등록·관리</span>
      </div>
      <img id="fridgeImg" src="/images/board/fridge2.png" style="height:70px;object-fit:contain;margin-right:10px;">
    </div>
  </a>
  <a href="/sharing" class="quick-action-btn">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
      <div>
        <span class="qa-label">나눔 게시판</span>
        <span class="qa-desc">동네 나눔 확인</span>
      </div>
      <img src="/images/character/complete.png" style="height:60px;object-fit:contain;margin-right:23px;margin-top:6px;">
    </div>
  </a>
  <a href="/park" class="quick-action-btn" onmouseover="document.getElementById('parkImg').src='/images/board/park2.png'" onmouseout="document.getElementById('parkImg').src='/images/board/park.png'">
    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
      <div>
        <span class="qa-label">내 공원</span>
        <span class="qa-desc">공원 꾸미기</span>
      </div>
      <img id="parkImg" src="/images/board/park.png" style="height:70px;object-fit:contain;margin-right:10px;">
    </div>
  </a>
</div>

<style>
.page-header { margin-bottom:24px; }
.page-header-top { display:flex; align-items:center; justify-content:space-between; }
.page-header-user { display:flex; align-items:center; gap:16px; }
.user-avatar { width:52px; height:52px; background:#e8f5e0; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:28px; }
.welcome-text { font-size:18px; font-weight:600; color:#1a3a15; }
.welcome-sub { font-size:13px; color:#888; margin-top:2px; }
.btn-park-link { background:#2d5a27; color:#fff; padding:10px 20px; border-radius:10px; text-decoration:none; font-size:13px; font-weight:600; }

.dashboard-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }
.card { background:#fff; border-radius:16px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,.06); }
.card-wide { grid-column:span 1; }
.card-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
.card-title { font-size:15px; font-weight:700; color:#222; }
.card-link { font-size:12px; color:#2d5a27; text-decoration:none; }

.urgent-items { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.urgent-item { background:#f8fdf4; border-radius:12px; padding:14px; display:flex; flex-direction:column; gap:6px; }
.urgent-item-top { display:flex; align-items:center; justify-content:space-between; }
.urgent-item-left { display:flex; align-items:center; gap:8px; }
.urgent-item-icon { font-size:24px; }
.urgent-item-name { font-size:13px; font-weight:600; color:#333; }
.urgent-item-day { font-size:12px; font-weight:700; color:#f39c12; background:#fff8e1; padding:3px 8px; border-radius:8px; }

.urgent-item-day.expired { color:#c0392b; background:#ffe8e8; }
.urgent-item-day.day0 { color:#f56200 !important; background:#fff3e0 !important; }
.urgent-item-save { font-size:11px; color:#2d5a27; margin-top:2px; }

.btn-share-small { background:#2d5a27; color:#fff; border-radius:6px; padding:4px 10px; font-size:11px; text-decoration:none; }
.empty-state-small { text-align:center; color:#888; font-size:13px; padding:20px; grid-column:span 2; }

.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.stat-item { background:#f8fdf4; border-radius:10px; padding:16px; text-align:center; }
.stat-label { font-size:12px; color:#888; margin-bottom:6px; }
.stat-value { font-size:22px; font-weight:700; color:#2d5a27; }

.quick-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.quick-action-btn { background:#fff; border-radius:16px; padding:24px; text-decoration:none; display:flex; flex-direction:column; align-items:flex-start; box-shadow:0 2px 12px rgba(0,0,0,.06); transition:transform .15s,box-shadow .15s; }
.quick-action-btn:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,.1); }
.qa-label { font-size:15px; font-weight:700; color:#222; display:block; margin-bottom:4px; }
.qa-desc { font-size:12px; color:#888; display:block; }
</style>