<style>
.page-title { font-size:22px; font-weight:700; color:#1a3a15; margin-bottom:24px; }
.stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px; }
.stat-card { background:#fff; border-radius:16px; padding:24px; text-align:center; box-shadow:0 2px 12px rgba(0,0,0,.06); }
.stat-icon { font-size:36px; margin-bottom:10px; display:flex; justify-content:center; align-items:flex-end; min-height:60px; }
.stat-value { font-size:28px; font-weight:800; margin-bottom:4px; }
.stat-value.green { color:#2d5a27; }
.stat-value.orange { color:#e67e22; }
.stat-value.blue { color:#2980b9; }
.stat-label { font-size:13px; color:#999; }
.section-card { background:#fff; border-radius:16px; padding:24px; box-shadow:0 2px 12px rgba(0,0,0,.06); margin-bottom:20px; }
.section-card-title { font-size:15px; font-weight:700; color:#1a3a15; margin-bottom:16px; }

.two-column-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
@media (max-width: 768px) { .two-column-layout { grid-template-columns: 1fr; } }
.inner-section { margin-bottom: 24px; }
.inner-title { font-size: 14px; font-weight: 700; color: #2d5a27; margin-bottom: 12px; border-bottom: 1px solid #e8f5e0; padding-bottom: 8px; }

.summary-row { display:flex; gap:32px; }
.summary-item { font-size:14px; color:#555; }
.summary-item strong { color:#2d5a27; font-weight:700; }
.activity-list { display:flex; flex-direction:column; gap:10px; max-height: 250px; overflow-y: auto; padding-right: 5px;}
.activity-list::-webkit-scrollbar { width: 5px; }
.activity-list::-webkit-scrollbar-thumb { background: #dcdcdc; border-radius: 5px; }
.activity-item { display:flex; align-items:center; gap:14px; padding:12px 16px; background:#f8fdf4; border-radius:10px; text-decoration:none; color:inherit; border:1px solid transparent; transition:transform 0.2s; }
.activity-item:hover { transform:translateY(-2px); border-color:#c8e6c9; box-shadow:0 4px 12px rgba(45,90,39,0.08); }
.activity-dot { width:10px; height:10px; border-radius:50%; background:#2d5a27; flex-shrink:0; }
.activity-dot.completed { background: #9e9e9e; } 
.activity-text { font-size:14px; color:#444; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.activity-text.completed { color: #888; text-decoration: line-through; }
.activity-date { font-size:12px; color:#bbb; }
.empty-activity { text-align:center; padding:40px; color:#ccc; font-size:14px; background:#fafafa; border-radius:12px; }
</style>

<h2 class="page-title">내 활동</h2>

<div class="stats-row">
  <div class="stat-card">
    <div class="stat-icon"><img src="/images/character/complete.png" style="height:50px;object-fit:contain;margin-top:10px;"></div>
    <div class="stat-value green"><%= sharingCompleted %></div>
    <div class="stat-label">나눔 완료</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><img src="/images/act/money.png" style="height:50px;object-fit:contain;margin-top:8px;"></div>
    <div class="stat-value orange"><%= (member.cumulativeSavings||0).toLocaleString() %>원</div>
    <div class="stat-label">절약한 금액</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><img src="/images/act/save.png" style="height:50px;object-fit:contain;margin-top:8px;"></div>
    <div class="stat-value blue"><%= member.cumulativeCarbonReduction||0 %>kg</div>
    <div class="stat-label">CO₂ 절약</div>
  </div>
</div>

<div class="two-column-layout" style="margin-top:20px; margin-bottom:20px;">
  <!-- 좌 : 내가 작성한 나눔글 영역 -->
  <div class="section-card" style="margin-bottom: 0;">
    <div class="section-card-title">🥬 내가 작성한 나눔글</div>
    
    <div class="inner-section">
      <div class="inner-title">진행 중인 내 나눔</div>
      <% if (ongoingPosts && ongoingPosts.length > 0) { %>
        <div class="activity-list">
          <% ongoingPosts.forEach(post => { %>
            <a href="/sharing/<%= post.sharingId %>" class="activity-item">
              <div class="activity-dot"></div>
              <div class="activity-text"><%= post.postTitle %></div>
              <div class="activity-date"><%= new Date(post.createdAt).toLocaleDateString('ko-KR') %></div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-activity">진행 중인 나눔이 없습니다.</div>
      <% } %>
    </div>

    <div class="inner-section">
      <div class="inner-title" style="color: #666;">나눔 완료된 게시글</div>
      <% if (completedPosts && completedPosts.length > 0) { %>
        <div class="activity-list">
          <% completedPosts.forEach(post => { %>
            <a href="/sharing/<%= post.sharingId %>" class="activity-item" style="background:#f5f5f5; border-color:#eee;">
              <div class="activity-dot completed"></div>
              <div class="activity-text completed"><%= post.postTitle %></div>
              <div class="activity-date"><%= new Date(post.updatedAt).toLocaleDateString('ko-KR') %></div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-activity">완료된 나눔이 없습니다.</div>
      <% } %>
    </div>
  </div>

  <!-- 우 : 내 대화 목록 (댓글/채팅) 영역 -->
  <div class="section-card" style="margin-bottom: 0;">
    <div class="section-card-title">💬 내 대화 목록</div>

    <div class="inner-section">
      <div class="inner-title">진행 중인 대화</div>
      <% if (ongoingChats && ongoingChats.length > 0) { %>
        <div class="activity-list">
          <% ongoingChats.forEach(room => { 
               const partnerName = (currentUser.memberId === room.sellerId) ? room.buyer.memberName : room.seller.memberName;
          %>
            <a href="/chat/room/<%= room.roomId %>" class="activity-item" style="border-left: 4px solid #e67e22;">
              <div class="activity-text">👤 <%= partnerName %>님과의 대화</div>
              <div class="activity-date"><%= new Date(room.updatedAt).toLocaleString('ko-KR', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-activity">진행 중인 대화가 없습니다.</div>
      <% } %>
    </div>

    <div class="inner-section">
      <div class="inner-title" style="color: #666;">완료된 대화</div>
      <% if (completedChats && completedChats.length > 0) { %>
        <div class="activity-list">
          <% completedChats.forEach(room => { 
               const partnerName = (currentUser.memberId === room.sellerId) ? room.buyer.memberName : room.seller.memberName;
          %>
            <a href="/chat/room/<%= room.roomId %>" class="activity-item" style="border-left: 4px solid #9e9e9e; background:#f5f5f5;">
              <div class="activity-text" style="color:#666;">👤 <%= partnerName %>님과의 대화</div>
              <div class="activity-date"><%= new Date(room.updatedAt).toLocaleString('ko-KR', { month:'short', day:'numeric' }) %></div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-activity">완료된 대화가 없습니다.</div>
      <% } %>
    </div>
  </div>
</div>

