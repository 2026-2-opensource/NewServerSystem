              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();\r\nconst title = pm.collectionVariables.get(\"shareTitle\");\r\n\r\npm.test(\"방금 작성한 글이 목록에 보임\", function () {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(html).to.include(title);\r\n});\r\n\r\n// 23번(나눔 완료)에서 쓸 게시글 id 저장\r\nconst titleIndex = html.indexOf(title);\r\nconst linkIndex = html.lastIndexOf('href=\"/sharing/', titleIndex);\r\nconst match = html.substring(linkIndex).match(/href=\"\\/sharing\\/([^\"]+)\"/);\r\nif (titleIndex !== -1 && match) {\r\n    pm.collectionVariables.set(\"sharingId\", match[1]);\r\n}\r\n\r\npm.test(\"게시글 id 저장됨\", function () {\r\n    pm.expect(pm.collectionVariables.get(\"sharingId\")).to.be.ok;\r\n});"
