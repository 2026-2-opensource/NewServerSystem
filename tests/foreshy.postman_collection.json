                  "const html = pm.response.text();\r\n\r\npm.test(\"활동 페이지 열기(200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"통계 그래프 영역 표시\", function () {\r\n    pm.expect(html).to.include(\"최근 3개월 통계\");\r\n    pm.expect(html).to.include('id=\"statsChart\"');\r\n});\r\n\r\n// 상단 통계 카드 숫자 꺼내기\r\nconst getStat = (color) => {\r\n    const m = html.match(new RegExp('stat-value ' + color + '\">([^<]+)<'));\r\n    return m ? parseFloat(m[1].replace(/[^0-9.]/g, \"\")) : NaN;\r\n};\r\n\r\npm.test(\"나눔 완료 1회 이상 반영\", function () {\r\n    pm.expect(getStat(\"green\")).to.be.at.least(1);\r\n});\r\n\r\npm.test(\"절약 금액 반영 (0원보다 큼)\", function () {\r\n    pm.expect(getStat(\"orange\")).to.be.above(0);\r\n});\r\n\r\npm.test(\"CO2 절감량 반영 (0kg보다 큼)\", function () {\r\n    pm.expect(getStat(\"blue\")).to.be.above(0);\r\n});\r\n\r\npm.test(\"나눔 완료한 글이 '나눔 완료된 게시글'에 표시\", function () {\r\n    const title = pm.collectionVariables.get(\"shareTitle\");\r\n    pm.expect(html).to.include('activity-text completed\">' + title);\r\n});\r\n\r\npm.test(\"이번 달 그래프 데이터에 절약 금액 반영\", function () {\r\n    const m = html.match(/const monthlyData = (\\[[\\s\\S]*?\\]);/);\r\n    pm.expect(m).to.not.be.null;\r\n    const data = JSON.parse(m[1]);\r\n    pm.expect(data[data.length - 1].savings).to.be.above(0);\r\n});"
