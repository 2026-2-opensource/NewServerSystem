        {
          "name": "게시판 목록 열기 -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();\r\n\r\npm.test(\"나눔 게시판 열기(200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"우리 동네 게시판 표시\", function () {\r\n    pm.expect(html).to.include(\"전체 게시판\");\r\n});\r\n\r\n// 나눔 등록 창의 식재료 목록에서 방금 등록한 식재료 id 꺼내기\r\nconst name = pm.collectionVariables.get(\"shareIngredientName\");\r\nconst nameIndex = html.indexOf(name);\r\nconst start = html.lastIndexOf(\"selectIngredient(this, '\", nameIndex);\r\nconst match = html.substring(start).match(/selectIngredient\\(this, '([^']+)'/);\r\nif (nameIndex !== -1 && match) {\r\n    pm.collectionVariables.set(\"shareOwnedId\", match[1]);\r\n}\r\n\r\npm.test(\"나눔용 식재료 id 저장됨\", function () {\r\n    pm.expect(pm.collectionVariables.get(\"shareOwnedId\")).to.be.ok;\r\n});"
                ]
              }
            }
